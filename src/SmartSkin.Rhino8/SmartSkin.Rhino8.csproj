<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>SmartSkin.Rhino8</RootNamespace>
    <AssemblyName>SmartSkin.Rhino8</AssemblyName>
    <AssemblyTitle>Smart Skin</AssemblyTitle>
    <Description>Read-only geometry preflight and surface-strategy routing for the Smart Skin Rhino 8 plug-in.</Description>
    <TargetExt>.rhp</TargetExt>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartSkin.Core\SmartSkin.Core.csproj" />
    <PackageReference Include="RhinoCommon" Version="8.14.24345.15001" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
